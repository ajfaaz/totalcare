SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost

# Local default uses SQLite. Switch to postgres by uncommenting below.
# DB_ENGINE=postgres
# DB_NAME=totalcare
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=127.0.0.1
# DB_PORT=5432

# Or use a full connection string instead.
# DATABASE_URL=postgres://user:password@127.0.0.1:5432/totalcare

EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password

# Production-only cookie domain settings
# SESSION_COOKIE_DOMAIN=.totalcare.arewanetventures.com
# CSRF_COOKIE_DOMAIN=.totalcare.arewanetventures.com
